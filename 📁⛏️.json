{
    "enhConfig": {
        "enhKey": "📁⛏️",
        "spawn": "folder-picker/folder-picker.js",
        "withAttrs": {
            "base": "📁⛏️",
            "noNudge": "${base}-no-nudge",
            "_noNudge": {
                "instanceOf": "Boolean"
            },
            "_base": {
                "instanceOf": "Object",
                "mapsTo": "."
            }
        }
    },
    "customData": {
        "weakRef": {
            "properties": [
                "enhancedElement"
            ]
        },
        "propagate": [
            "noNudge",
            "options"
        ],
        "actions": {
            "hydrate": {
                "ifAllOf": [
                    "enhancedElement",
                    "initialized"
                ]
            }
        },
        "compacts": {
            "when_resolved_changes_dispatch": "resolved"
        },
        "defaultPropVals": {
            "noNudge": false,
            "options": {}
        }
    }
}
