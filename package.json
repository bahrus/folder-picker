{
  "name": "folder-picker",
  "version": "0.0.5",
  "description": "Enhance an HTML button so that it prompts the user to picka a local directory / folder and provides a reference to the chosen folder (FileSystemDirectoryHandle)",
  "homepage": "https://github.com/bahrus/folder-picker#readme",
  "bugs": {
    "url": "https://github.com/bahrus/folder-picker/issues"
  },
  "repository": {
